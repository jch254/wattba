<div class="gate">
  <div class="scr">
    <pre></pre>
    <div class="line" style="display: flex; visibility: hidden">
      <span class="ps" aria-hidden="true"> &gt;: </span>
      <span class="mask" aria-hidden="true"></span>
      <span class="cur" aria-hidden="true"></span>
      <input
        type="text"
        value=""
        autocomplete="off"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        aria-label="Access code"
        inputmode="text"
        enterkeyhint="go"
        style="visibility: visible; opacity: 0"
      />
    </div>
    <div class="deny" role="alert" style="display: none">
      ACCESS DENIED. TRY AGAIN.
    </div>
    <div class="grant" role="status" style="display: none">ACCESS GRANTED</div>
  </div>
</div>

<script>
  const PASSWORD_HASH =
    '0d45c7a3c88662e83ba778e364b4a26f62cd4483f056c18be8fcb853e9c58d01';
  const BOOT_TEXT = [
    'BOOTING GUIDE SYSTEM...',
    'MEMORY CHECK OK',
    'LOADING "GETTING GOING WITH AI"',
    'ENTER ACCESS CODE:',
  ].join('\n');

  const wait = (milliseconds: number): Promise<void> =>
    new Promise((resolve) => {
      window.setTimeout(resolve, milliseconds);
    });

  async function hashAccessCode(value: string): Promise<string> {
    const bytes = new TextEncoder().encode(value.trim().toLowerCase());
    const digest = await crypto.subtle.digest('SHA-256', bytes);
    return Array.from(new Uint8Array(digest), (byte) =>
      byte.toString(16).padStart(2, '0'),
    ).join('');
  }

  function initializeGate(): void {
    const gate = document.querySelector<HTMLElement>('.gate');
    const guide = document.querySelector<HTMLElement>('.g#guide');
    const boot = gate?.querySelector<HTMLPreElement>('pre');
    const line = gate?.querySelector<HTMLElement>('.line');
    const mask = gate?.querySelector<HTMLElement>('.mask');
    const input = gate?.querySelector<HTMLInputElement>('input');
    const deny = gate?.querySelector<HTMLElement>('.deny');
    const grant = gate?.querySelector<HTMLElement>('.grant');

    if (
      !gate ||
      !guide ||
      !boot ||
      !line ||
      !mask ||
      !input ||
      !deny ||
      !grant
    ) {
      return;
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let ready = false;
    let checking = false;
    let unlocked = false;

    const focusInput = (): void => {
      if (!unlocked) {
        input.focus({ preventScroll: true });
      }
    };

    const revealGuide = (animate: boolean): void => {
      unlocked = true;
      input.blur();
      gate.style.display = 'none';
      guide.style.display = 'flex';
      if (animate && !reducedMotion.matches) {
        guide.classList.add('reveal');
      }
    };

    try {
      if (sessionStorage.getItem('guide-unlocked') === 'true') {
        revealGuide(false);
        return;
      }
    } catch {
      // Unavailable storage must not bypass the gate.
    }

    gate.addEventListener('click', focusInput);
    input.addEventListener('input', () => {
      mask.textContent = '*'.repeat(input.value.length);
    });

    const rejectAccess = (): void => {
      checking = false;
      input.readOnly = false;
      input.value = '';
      mask.textContent = '';
      grant.style.display = 'none';
      deny.style.display = 'block';
      focusInput();
    };

    const submitAccessCode = async (): Promise<void> => {
      if (!ready || checking || unlocked) {
        return;
      }

      checking = true;
      input.readOnly = true;
      deny.style.display = 'none';

      try {
        if ((await hashAccessCode(input.value)) !== PASSWORD_HASH) {
          rejectAccess();
          return;
        }
      } catch {
        rejectAccess();
        return;
      }

      try {
        sessionStorage.setItem('guide-unlocked', 'true');
      } catch {
        // A valid code still unlocks this page when storage is unavailable.
      }

      input.value = '';
      mask.textContent = '';
      grant.style.display = 'block';
      await wait(1000);
      if (!reducedMotion.matches) {
        gate.classList.add('out');
        await wait(600);
      }
      revealGuide(true);
    };

    input.addEventListener('keydown', (event: KeyboardEvent) => {
      if (event.key === 'Enter' && !event.isComposing) {
        event.preventDefault();
        void submitAccessCode();
      }
    });

    const runBoot = async (): Promise<void> => {
      boot.textContent = '';
      for (let index = 0; index < BOOT_TEXT.length; index += 1) {
        if (reducedMotion.matches) {
          boot.textContent = BOOT_TEXT;
          break;
        }
        boot.textContent = BOOT_TEXT.slice(0, index + 1);
        await wait(25);
      }
      line.style.visibility = 'visible';
      ready = true;
      focusInput();
    };

    void runBoot();
  }

  initializeGate();
</script>
