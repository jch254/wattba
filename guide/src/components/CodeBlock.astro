---
interface Props {
  label: string;
  code: string;
  copy?: boolean;
}
const { label, code, copy = false } = Astro.props;
---

<div class="code">
  <div class="bar">
    <span>{label}</span>{copy && <button type="button">Copy</button>}
  </div><pre>{code}</pre>
</div>
<script>
  document
    .querySelectorAll<HTMLButtonElement>('.code button')
    .forEach((button) => {
      let timer: ReturnType<typeof setTimeout>;
      button.addEventListener('click', async () => {
        const code = button.closest('.code')?.querySelector('pre')?.textContent;
        if (code === undefined || code === null) return;
        try {
          await navigator.clipboard.writeText(code);
          clearTimeout(timer);
          button.textContent = 'Copied';
          timer = setTimeout(() => {
            button.textContent = 'Copy';
          }, 1600);
        } catch {
          // Keep the original label when clipboard access is unavailable.
        }
      });
    });
</script>
