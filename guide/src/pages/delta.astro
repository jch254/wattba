---
import Layout from '../layouts/Layout.astro';
import GuideNav from '../components/GuideNav.astro';
import DeltaFollowUp from '../components/sections/DeltaFollowUp.astro';
---

<Layout>
  <div
    class="g"
    id="guide"
    style="width: 100%; min-height: 100%; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; background: var(--color-0a0f0b)"
  >
    <GuideNav current="delta" />
    <main id="main-content" class="guide-content" tabindex="-1">
      <DeltaFollowUp />
    </main>
  </div>
</Layout>
